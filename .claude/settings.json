{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git fetch --prune*)",
      "Bash(git check-ignore *)",
      "Bash(uv sync*)",
      "Bash(uv lock --check*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff *)",
      "Bash(uv run pre-commit run*)",
      "Bash(uv run skycast*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list*)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git branch -d *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(rm *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue develop *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh api *)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./.pre-commit-config.yaml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.production)",
      "Bash(git add .)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(rm -rf *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api -X DELETE*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-fix.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
