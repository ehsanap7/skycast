# Copy to .env and fill in the keys. Never commit .env.

# Object storage endpoint used by commands on the host.
SKYCAST_S3_ENDPOINT=http://127.0.0.1:8333

# Generate each value with: openssl rand -hex 24
SKYCAST_S3_ACCESS_KEY=
SKYCAST_S3_SECRET_KEY=

# Starts the SeaweedFS service with Docker Compose.
COMPOSE_PROFILES=storage
